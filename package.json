{
  "name": "duelforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit -p . && vite build && node scripts/build-server.mjs",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "simulate": "tsx scripts/simulate-meta.ts",
    "build:static": "node scripts/build-static.mjs",
    "simulate:real": "tsx scripts/simulate-real.ts",
    "cards": "tsx scripts/fetch-cards.ts"
  },
  "dependencies": {
    "framer-motion": "12.43.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-router-dom": "7.18.5",
    "ws": "8.22.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "10.0.6",
    "esbuild": "0.25.11",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  }
}
